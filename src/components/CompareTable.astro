---
const rows = [
  ['Source material', 'Your existing website', 'New knowledge from your sales team'],
  ['Output', 'Dashboards and rewrite suggestions', 'Published pages plus your own AI connector'],
  ['Who does the work', 'Your marketing team', 'We interview, write and publish'],
  ['Reach', 'Public AI answers only', 'Public AI answers, AI apps, your chatbot and your reps'],
];
---
<div class="scroll" role="region" aria-labelledby="compare-caption" tabindex="0">
  <table>
    <caption id="compare-caption" class="visually-hidden">Typical AEO / GEO tool compared with this service</caption>
    <thead>
      <tr>
        <td></td>
        <th scope="col">Typical AEO / GEO tool</th>
        <th scope="col" class="ours">This service</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map(([label, typical, ours]) => (
          <tr>
            <th scope="row">{label}</th>
            <td class="typical">{typical}</td>
            <td>{ours}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .scroll {
    overflow-x: auto;
    border: 1px solid var(--rule-frame);
  }
  table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 17px;
  }
  thead tr {
    background: var(--panel);
  }
  thead th,
  thead td {
    text-align: left;
    padding: 18px 24px;
    font-family: var(--mono);
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-label);
    border-bottom: 1px solid var(--rule-frame);
  }
  thead .ours {
    color: var(--clay-light);
  }
  tbody th,
  tbody td {
    text-align: left;
    vertical-align: top;
    padding: 18px 24px;
    border-bottom: 1px solid var(--rule);
  }
  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }
  tbody th {
    font-weight: 600;
  }
  .typical {
    color: var(--text-muted);
  }
</style>

---
import type { Package } from '../config/site';
import { formatPrice } from '../config/site';
import Button from './Button.astro';

interface Props {
  pkg: Package;
}
const { pkg } = Astro.props;
---
<article class:list={['card', { featured: pkg.featured }]} aria-labelledby={`pkg-${pkg.name.toLowerCase()}`}>
  <h3 class="label" id={`pkg-${pkg.name.toLowerCase()}`}>{pkg.label}</h3>
  <p class="price">
    {formatPrice(pkg.price)}{pkg.unit && <span class="unit">{pkg.unit}</span>}
  </p>
  <p class="sub">{pkg.sub}</p>
  <ul>
    {pkg.bullets.map((b) => <li>{b}</li>)}
  </ul>
  <div class="cta">
    <Button href="#contact" variant={pkg.featured ? 'primary' : 'ghost'} block>{pkg.cta}</Button>
  </div>
</article>

<style>
  .card {
    background: var(--panel);
    border: 1px solid var(--rule-frame);
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .featured {
    border: 2px solid var(--clay);
  }
  .label {
    font-family: var(--mono);
    line-height: 1.5;
  }
  .featured .label {
    color: var(--clay-light);
  }
  .price {
    font-family: var(--display);
    font-size: 52px;
    line-height: 1;
  }
  .unit {
    font-family: var(--serif);
    font-size: 20px;
    color: var(--text-muted);
  }
  .sub {
    font-size: 15px;
    color: var(--text-muted);
  }
  ul {
    margin: 0;
    padding: 0 0 0 18px;
    color: var(--text-body);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cta {
    margin-top: auto;
  }
  @media (max-width: 480px) {
    .card {
      padding: 28px 24px;
    }
  }
</style>

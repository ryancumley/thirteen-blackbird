---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  ratio: string; // e.g. "4 / 3"
  widths: number[];
  sizes: string;
  width?: number; // fixed display width (square headshot)
  class?: string;
}
const { src, alt, caption, ratio, widths, sizes, width, class: className } = Astro.props;
const [w, h] = ratio.split('/').map((n) => Number(n.trim()));
const baseWidth = width ?? Math.max(...widths);
---
<figure class:list={['figure', className]} style={width ? `width:${width}px` : undefined}>
  <Image
    src={src}
    alt={alt}
    width={baseWidth}
    height={Math.round((baseWidth * h) / w)}
    widths={widths}
    sizes={sizes}
    fit="cover"
    format="webp"
    quality={75}
    style={`aspect-ratio:${ratio}`}
  />
  <figcaption class="label">{caption}</figcaption>
</figure>

<style>
  .figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 100%;
  }
  .figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    border: 1px solid var(--rule-frame);
    background: var(--panel);
  }
  .label {
    letter-spacing: 0.14em;
  }
</style>

---
interface Props {
  label: string;
  title: string;
}
const { label, title } = Astro.props;
---
<div class="card">
  <div class="label">{label}</div>
  <h3>{title}</h3>
  <p><slot /></p>
</div>

<style>
  .card {
    background: var(--panel);
    border: 1px solid var(--rule-frame);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  h3 {
    font-size: 26px;
    line-height: 1.1;
  }
  p {
    color: var(--text-body);
    font-size: 16px;
  }
</style>

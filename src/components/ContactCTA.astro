---
import { contact, photos } from '../config/site';
import headshot from '../assets/photos/headshot.jpg';
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
import PlaceholderFigure from './PlaceholderFigure.astro';
---
<section id="contact" class="contact" aria-labelledby="contact-heading">
  <div class="container section inner">
    <PlaceholderFigure
      src={headshot}
      alt={photos.headshot.alt}
      caption={photos.headshot.caption}
      ratio="1 / 1"
      width={220}
      widths={[220, 440]}
      sizes="220px"
      class="photo"
    />
    <div class="text">
      <SectionHeading id="contact-heading" size="contact" text="Find out what AI says about you." accent="Free." />
      <p class="lede">
        On a 30-minute call we’ll check what AI assistants say about you today and pick the five
        questions your Pilot should answer first.
      </p>
    </div>
    <div class="action">
      <Button href={contact.bookingHref} size="xl" block>Book a 30-minute call</Button>
      <p class="details">{contact.name} · {contact.email} · {contact.phone}</p>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--panel);
    border-top: 1px solid var(--rule-frame);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: center;
    justify-content: space-between;
  }
  .inner :global(.photo) {
    flex: 0 0 220px;
  }
  .text {
    flex: 999 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .lede {
    font-size: 20px;
    color: var(--text-body);
    max-width: 38rem;
  }
  .action {
    flex: 1 1 280px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .details {
    font-size: 15px;
    color: var(--text-muted);
    text-align: center;
  }
</style>

---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost';
  size?: 'md' | 'lg' | 'xl';
  block?: boolean;
}
const { href, variant = 'primary', size = 'md', block = false } = Astro.props;
---
<a href={href} class:list={['btn', variant, size, { block }]}><slot /></a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 11px 20px;
    font-size: 16px;
    text-decoration: none;
    transition: background-color 0.15s, border-color 0.15s;
  }
  .primary {
    background: var(--clay);
    color: #fff;
  }
  .primary:hover {
    background: var(--clay-hover);
    color: #fff;
  }
  .ghost {
    border: 1px solid var(--rule-button);
    color: var(--text);
  }
  .ghost:hover {
    border-color: var(--text-muted);
    color: var(--text);
  }
  .lg {
    min-height: 52px;
    padding: 16px 26px;
    font-size: 17px;
  }
  .xl {
    min-height: 56px;
    padding: 18px 28px;
    font-size: 18px;
  }
  .block {
    display: flex;
    min-height: 48px;
    padding: 14px 20px;
  }
  .block.xl {
    min-height: 56px;
    padding: 18px 28px;
  }
  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none;
    }
  }
</style>
